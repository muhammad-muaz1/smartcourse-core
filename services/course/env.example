# course service. Copy to services/course/.env (`make env` does it) and adjust.
#
# Prefix: SMARTCOURSE_ — nested groups joined with __, e.g. SMARTCOURSE_APP__ENV.

# --- app ---
SMARTCOURSE_APP__ENV=local
SMARTCOURSE_APP__DEBUG=true
# reload=true is for local dev only (`make dev`) — never in a shared environment.
SMARTCOURSE_APP__RELOAD=true
SMARTCOURSE_APP__HOST=0.0.0.0
SMARTCOURSE_APP__PORT=8002

# --- log ---
SMARTCOURSE_LOG__LEVEL=INFO
SMARTCOURSE_LOG__JSON_LOGS=true

# --- cors ---
SMARTCOURSE_CORS__ALLOW_ORIGINS=["http://localhost:3000"]
SMARTCOURSE_CORS__ALLOW_CREDENTIALS=true

# --- postgres: course_db, this service's own database. Throwaway local container
# credentials; a real deployment injects its DSN from its secrets manager. ---
SMARTCOURSE_POSTGRES__DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/course_db
SMARTCOURSE_POSTGRES__POOL_SIZE=10
SMARTCOURSE_POSTGRES__MAX_OVERFLOW=5
SMARTCOURSE_POSTGRES__ECHO=false

# --- health ---
SMARTCOURSE_HEALTH__CHECK_TIMEOUT_SECONDS=2.0
SMARTCOURSE_HEALTH__CACHE_TTL_SECONDS=5.0

# --- security: identity's PUBLIC key only — this service verifies, never issues.
# Relative to services/course/. ---
SMARTCOURSE_SECURITY__JWT_PUBLIC_KEY_PATH=../../secrets/jwt_public.pem
SMARTCOURSE_SECURITY__JWT_ALGORITHM=RS256

# --- redis: DB 1 is course's. Idempotency-Key responses for publish. ---
SMARTCOURSE_REDIS__URL=redis://localhost:6379/1

# --- idempotency (★ endpoints: POST /courses/{id}/publish) ---
SMARTCOURSE_IDEMPOTENCY__RESPONSE_TTL_SECONDS=86400
SMARTCOURSE_IDEMPOTENCY__IN_FLIGHT_TTL_SECONDS=60

# --- temporal + outbox relay: used by the worker process only (`make worker s=course`).
# The API process never connects to Temporal. ---
SMARTCOURSE_TEMPORAL__TARGET=localhost:7233
SMARTCOURSE_TEMPORAL__NAMESPACE=default
SMARTCOURSE_TEMPORAL__TASK_QUEUE=course-tq
SMARTCOURSE_OUTBOX__POLL_INTERVAL_SECONDS=1.0
SMARTCOURSE_OUTBOX__BATCH_SIZE=100
