# gateway. Copy to gateway/.env (`make env` does it) and adjust. Holds no data and no
# secrets — only where each service lives.
#
# Prefix: SMARTCOURSE_ — nested groups joined with __, e.g. SMARTCOURSE_APP__ENV.

# --- app ---
SMARTCOURSE_APP__ENV=local
SMARTCOURSE_APP__DEBUG=true
# reload=true is for local dev only (`make dev`) — never in a shared environment.
SMARTCOURSE_APP__RELOAD=true
SMARTCOURSE_APP__HOST=0.0.0.0
SMARTCOURSE_APP__PORT=8000
SMARTCOURSE_APP__API_PREFIX=/api/v1

# --- log ---
SMARTCOURSE_LOG__LEVEL=INFO
SMARTCOURSE_LOG__JSON_LOGS=true

# --- cors: browsers talk to the gateway, so this is the CORS policy clients see ---
SMARTCOURSE_CORS__ALLOW_ORIGINS=["http://localhost:3000"]
SMARTCOURSE_CORS__ALLOW_CREDENTIALS=true

# --- health (the gateway's /health checks every service's /health) ---
SMARTCOURSE_HEALTH__CHECK_TIMEOUT_SECONDS=2.0
SMARTCOURSE_HEALTH__CACHE_TTL_SECONDS=5.0

# --- upstreams ---
SMARTCOURSE_UPSTREAMS__IDENTITY_URL=http://localhost:8001
SMARTCOURSE_UPSTREAMS__COURSE_URL=http://localhost:8002
SMARTCOURSE_UPSTREAMS__LEARNING_URL=http://localhost:8003
SMARTCOURSE_UPSTREAMS__NOTIFICATION_URL=http://localhost:8004
SMARTCOURSE_UPSTREAMS__ANALYTICS_URL=http://localhost:8005
SMARTCOURSE_UPSTREAMS__TIMEOUT_SECONDS=10.0
SMARTCOURSE_UPSTREAMS__JWKS_CACHE_TTL_SECONDS=300

# --- telemetry: traces over OTLP/HTTP to Jaeger (`make jaeger`, UI :16686). Empty =
# spans are still created (trace ids reach logs and event headers) but not exported. ---
SMARTCOURSE_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318
SMARTCOURSE_TELEMETRY__SAMPLE_RATIO=1.0
