# Copy to .env and adjust. No real secrets belong in this file or in .env once the auth
# module introduces JWT signing keys — those are generated locally and gitignored,
# never stored as env values.
#
# Prefix: SMARTCOURSE_ — nested groups joined with __, e.g. SMARTCOURSE_APP__ENV.

# --- app ---
SMARTCOURSE_APP__ENV=local
SMARTCOURSE_APP__DEBUG=true
# reload=true is for local dev only (`make dev`) — never set this in a shared
# environment, even one that also has debug=true.
SMARTCOURSE_APP__RELOAD=true
SMARTCOURSE_APP__SERVICE_NAME=smartcourse-api
SMARTCOURSE_APP__HOST=0.0.0.0
SMARTCOURSE_APP__PORT=8000
SMARTCOURSE_APP__API_PREFIX=/api/v1

# --- log ---
SMARTCOURSE_LOG__LEVEL=INFO
SMARTCOURSE_LOG__JSON_LOGS=true

# --- cors ---
SMARTCOURSE_CORS__ALLOW_ORIGINS=["http://localhost:3000"]
SMARTCOURSE_CORS__ALLOW_CREDENTIALS=true

# --- postgres (no real secret in this default — throwaway local container creds; a
# real deployment injects its own DSN via its secrets manager, never committed here) ---
SMARTCOURSE_POSTGRES__DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcourse
SMARTCOURSE_POSTGRES__POOL_SIZE=10
SMARTCOURSE_POSTGRES__MAX_OVERFLOW=5
SMARTCOURSE_POSTGRES__ECHO=false

# --- mongo ---
SMARTCOURSE_MONGO__URL=mongodb://localhost:27017
SMARTCOURSE_MONGO__DATABASE=smartcourse
SMARTCOURSE_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

# --- redis ---
SMARTCOURSE_REDIS__URL=redis://localhost:6379/0
SMARTCOURSE_REDIS__SOCKET_TIMEOUT_SECONDS=2.0

# --- health (per-dependency check timeout + result cache TTL, so a probe hitting
# /health every second or two doesn't hammer the dependencies themselves) ---
SMARTCOURSE_HEALTH__CHECK_TIMEOUT_SECONDS=2.0
SMARTCOURSE_HEALTH__CACHE_TTL_SECONDS=5.0

# --- security (JWT keys are files, not env values — generate with `make keys`; never
# put a real private key anywhere in this file) ---
SMARTCOURSE_SECURITY__JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
SMARTCOURSE_SECURITY__JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
SMARTCOURSE_SECURITY__JWT_KID=dev-1
SMARTCOURSE_SECURITY__JWT_ALGORITHM=RS256
SMARTCOURSE_SECURITY__ACCESS_TOKEN_EXPIRES_MINUTES=15
SMARTCOURSE_SECURITY__REFRESH_TOKEN_EXPIRES_DAYS=30
SMARTCOURSE_SECURITY__PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
SMARTCOURSE_SECURITY__FAILED_LOGIN_MAX_ATTEMPTS=5
SMARTCOURSE_SECURITY__FAILED_LOGIN_LOCKOUT_SECONDS=300
SMARTCOURSE_SECURITY__REGISTER_THROTTLE_PER_HOUR=10
