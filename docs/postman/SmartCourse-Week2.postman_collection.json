              "mode": "raw",
              "raw": "{\n  \"email\": \"{{instructorEmail}}\",\n  \"password\": \"Passw0rd!x\",\n  \"full_name\": \"Ada Instructor\",\n  \"role\": \"instructor\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"instructorEmail\", `instructor+${Date.now()}@example.com`);"
