    {
      "name": "1. Courses",
      "item": [
        {
          "name": "Create course (with seat limit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ]
            },
            "description": "`max_enrollments` is new (omit or null = unlimited). Emits course.created.v1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Distributed Systems in Practice\",\n  \"description\": \"Sagas, outboxes and idempotency.\",\n  \"level\": \"advanced\",\n  \"max_enrollments\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"courseId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get course detail (with module tree)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "{{courseId}}"
              ]
            },
            "description": "Now includes `modules[]`, each with lesson summaries (no bodies)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update course metadata",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "{{courseId}}"
              ]
            },
            "description": "Allowed in draft/failed/published. `\"max_enrollments\": null` removes the limit; omitting it leaves it unchanged. 409 COURSE_NOT_EDITABLE while publishing or archived.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Distributed Systems in Practice (2026)\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List courses (catalogue)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courses?status=published&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "published"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": ""
